---
import type { HTMLAttributes } from 'astro/types'
import { getDictionary } from '@/i18n'

type Props = Omit<HTMLAttributes<'button'>, 'type' | 'hidden'>
const dictionary = getDictionary(Astro.currentLocale)
const { class: className, ...attributes } = Astro.props
---

<button
  {...attributes}
  class:list={[className]}
  type='button'
  data-cookie-preferences
  hidden
>
  <slot>{dictionary.cookies.preferences}</slot>
</button>
