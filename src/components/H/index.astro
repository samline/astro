---
import type { HTMLAttributes } from 'astro/types'

export interface Props extends HTMLAttributes<'h1'> {
  level: 1 | 2 | 3 | 4 | 5 | 6
}

const { level, class: className, ...attributes } = Astro.props
const headings = {
  1: 'h1',
  2: 'h2',
  3: 'h3',
  4: 'h4',
  5: 'h5',
  6: 'h6'
} as const
if (!Number.isInteger(level) || level < 1 || level > 6) {
  throw new RangeError('H requires a heading level from 1 to 6.')
}
const Tag = headings[level]
---

<Tag class:list={[className]} {...attributes}>
  <slot />
</Tag>
