---
import type { HTMLAttributes } from 'astro/types'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { resolveLocale } from '@/i18n'
import { locales } from '@/i18n/config'
import { routePath, type RouteName } from '@/i18n/routes'
import { currentDestination, type CurrentMatch } from './current'

export type LinkDestination =
  { href: string; routeName?: never } | { routeName: RouteName; href?: never }

export type Props = Omit<HTMLAttributes<'a'>, 'href'> &
  LinkDestination & {
    localize?: boolean
    variant?: 'plain' | 'text' | 'nav'
    currentMatch?: CurrentMatch
  }

const {
  href: suppliedHref,
  routeName,
  localize = true,
  variant = 'plain',
  currentMatch,
  'aria-current': ariaCurrent,
  target,
  rel,
  download,
  class: className,
  ...attributes
} = Astro.props

const appearances = {
  plain: '',
  text: 'text-accent underline underline-offset-4 hover:text-accent-dark dark:text-accent-light dark:hover:text-accent active:opacity-80',
  nav: 'text-inherit no-underline underline-offset-4 hover:underline [&[aria-current]:not([aria-current=false])]:underline [&[aria-current]:not([aria-current=false])]:font-semibold active:opacity-80'
}

const href =
  routeName !== undefined
    ? getRelativeLocaleUrl(
        resolveLocale(Astro.currentLocale),
        routePath({ routeName }, resolveLocale(Astro.currentLocale))
      )
    : suppliedHref!
let destination = href
if (
  routeName === undefined &&
  localize &&
  (download === undefined || download === false) &&
  href.startsWith('/') &&
  !href.startsWith('//')
) {
  const boundary = href.search(/[?#]/)
  const pathname = boundary === -1 ? href : href.slice(0, boundary)
  const suffix = boundary === -1 ? '' : href.slice(boundary)
  const firstSegment = pathname.split('/')[1]
  const hasLocale = locales.some((locale) => locale === firstSegment)

  if (!hasLocale) {
    destination =
      getRelativeLocaleUrl(resolveLocale(Astro.currentLocale), pathname) +
      suffix
  }
}

const relationships = rel?.split(/\s+/).filter(Boolean) ?? []
const current =
  ariaCurrent ??
  (currentMatch
    ? currentDestination(
        new URL(destination, Astro.url),
        Astro.url,
        currentMatch,
        getRelativeLocaleUrl(resolveLocale(Astro.currentLocale), '/')
      )
    : undefined)
if (
  target?.toLowerCase() === '_blank' &&
  !relationships.some((value) => value.toLowerCase() === 'noopener')
) {
  relationships.push('noopener')
}
---

<a
  href={destination}
  target={target}
  rel={relationships.length ? relationships.join(' ') : undefined}
  download={download}
  aria-current={current}
  class:list={[
    appearances[variant],
    variant !== 'plain' &&
      'focus-visible:outline-[0.125rem] focus-visible:outline-offset-[0.1875rem] focus-visible:outline-accent motion-safe:transition-colors',
    className
  ]}
  {...attributes}
>
  <slot />
</a>
