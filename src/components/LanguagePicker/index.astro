---
import Link from '@/components/Link/index.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { getDictionary, resolveLocale } from '@/i18n'
import { locales } from '@/i18n/config'
import { resolveRoutePaths, type PageRoute } from '@/i18n/routes'

type Props = PageRoute

const paths = resolveRoutePaths(Astro.props)
const translations = locales.filter((language) => paths[language] !== undefined)
const locale = resolveLocale(Astro.currentLocale)
const dictionary = getDictionary(locale)
---

{translations.length > 1 && (
  <nav aria-label={dictionary.common.language}>
    <ul>
      {translations.map((language) => (
        <li>
          <Link
            href={getRelativeLocaleUrl(language, paths[language]!)}
            localize={false}
            lang={language}
            hreflang={language}
            aria-current={language === locale ? 'page' : undefined}
          >
            {dictionary.languages[language]}
          </Link>
        </li>
      ))}
    </ul>
  </nav>
)}
