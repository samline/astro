---
import Button from '@/components/Button/index.astro'
import H from '@/components/H/index.astro'
import FaIcon from '@/components/FaIcon/index.astro'
import { faArrowLeft } from '@fortawesome/free-solid-svg-icons/faArrowLeft'
import { getDictionary } from '@/i18n'

const dictionary = getDictionary(Astro.currentLocale)
---

<p>{dictionary.errors.notFound.code}</p>
<H level={1} id='not-found-title'>
  {dictionary.errors.notFound.title}
</H>
<p>{dictionary.errors.notFound.description}</p>
<Button href='/'>
  <FaIcon icon={faArrowLeft} />
  {dictionary.buttons.backHome}
</Button>
