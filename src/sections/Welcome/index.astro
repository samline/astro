---
import Section from '@/components/Section/index.astro'
import Box from '@/components/Box/index.astro'
import WelcomeContent from './WelcomeContent.astro'
import LanguagePicker from '@/components/LanguagePicker/index.astro'
import ThemeSwitch from '@/components/Theme/Switch.astro'
---

<Section id='welcome' class='welcome' aria-labelledby='welcome-title'>
  <Box class='welcome-box'>
    <WelcomeContent />
    <LanguagePicker path='/' />
    <ThemeSwitch />
  </Box>
</Section>

<style>
  .welcome {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .welcome-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
</style>
