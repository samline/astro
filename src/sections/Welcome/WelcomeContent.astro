---
import Button from '@/components/Button/index.astro'
import H from '@/components/H/index.astro'
import { getDictionary } from '@/i18n'

const { navigation, welcome } = getDictionary(Astro.currentLocale)
---

<div class='grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-20'>
  <div class='space-y-6 light:text-black dark:text-white'>
    <H
      level={1}
      id='welcome-title'
      class='max-w-3xl text-4xl leading-tight font-semibold tracking-tight sm:text-5xl lg:text-6xl'
    >
      {welcome.title}
    </H>
    <p class='max-w-xl text-lg leading-relaxed text-black/65 dark:text-white/70'>
      {welcome.description}
    </p>
    <div class='flex flex-wrap gap-3 pt-2'>
      <Button href='/demo' class='min-w-0 max-w-full [overflow-wrap:anywhere]'>
        {navigation.demo}
      </Button>
      <Button
        href='https://docs.astro.build/'
        variant='secondary'
        class='min-w-0 max-w-full [overflow-wrap:anywhere]'
      >
        {navigation.documentation}
      </Button>
    </div>
  </div>
  <div class='rounded-2xl border border-black/10 bg-black/[0.02] p-6 sm:p-8 dark:border-white/15 dark:bg-white/[0.03]'>
    <H level={2} class='text-lg font-semibold'>
      {welcome.filesTitle}
    </H>
    <ul class='mt-6 divide-y divide-black/10 dark:divide-white/15'>
      {welcome.files.map((file) => (
        <li class='space-y-2 py-5 first:pt-0 last:pb-0'>
          <code class='text-sm break-words text-accent [overflow-wrap:anywhere] dark:text-accent-light'>
            {file.path}
          </code>
          <p class='font-medium'>{file.title}</p>
          <p class='text-sm leading-relaxed text-black/65 dark:text-white/65'>
            {file.description}
          </p>
        </li>
      ))}
    </ul>
  </div>
</div>
