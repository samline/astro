---
import Link from '@/components/Link/index.astro'
import astroLogo from '@/assets/astro.svg'
import background from '@/assets/background.svg'
import { getDictionary } from '@/i18n'

const dictionary = getDictionary(Astro.currentLocale)
---

<img id='background' src={background.src} alt='' fetchpriority='high' />
<div id='hero' class='light:text-black dark:text-white'>
  <Link href='https://astro.build'>
    <img
      class='dark:brightness-0 dark:invert'
      src={astroLogo.src}
      width='115'
      height='48'
      alt={dictionary.welcome.logoAlt}
    />
  </Link>
  <h1 id='welcome-title'>
    {dictionary.welcome.titleBeforeCode}{' '}
    <code>
      <pre>{dictionary.welcome.directoryPath}</pre>
    </code>{' '}
    {dictionary.welcome.titleAfterCode}
  </h1>
  <div id='links'>
    <Link class='button' href='https://docs.astro.build'>
      {dictionary.navigation.documentation}
    </Link>
    <Link href='https://astro.build/chat'>
      {dictionary.navigation.community}{' '}
      <svg
        aria-hidden='true'
        xmlns='http://www.w3.org/2000/svg'
        viewBox='0 0 127.14 96.36'
      >
        <path
          fill='currentColor'
          d='M107.7 8.07A105.15 105.15 0 0 0 81.47 0a72.06 72.06 0 0 0-3.36 6.83 97.68 97.68 0 0 0-29.11 0A72.37 72.37 0 0 0 45.64 0a105.89 105.89 0 0 0-26.25 8.09C2.79 32.65-1.71 56.6.54 80.21a105.73 105.73 0 0 0 32.17 16.15 77.7 77.7 0 0 0 6.89-11.11 68.42 68.42 0 0 1-10.85-5.18c.91-.66 1.8-1.34 2.66-2a75.57 75.57 0 0 0 64.32 0c.87.71 1.76 1.39 2.66 2a68.68 68.68 0 0 1-10.87 5.19 77 77 0 0 0 6.89 11.1 105.25 105.25 0 0 0 32.19-16.14c2.64-27.38-4.51-51.11-18.9-72.15ZM42.45 65.69C36.18 65.69 31 60 31 53s5-12.74 11.43-12.74S54 46 53.89 53s-5.05 12.69-11.44 12.69Zm42.24 0C78.41 65.69 73.25 60 73.25 53s5-12.74 11.44-12.74S96.23 46 96.12 53s-5.04 12.69-11.43 12.69Z'
        ></path>
      </svg>
    </Link>
  </div>
</div>

<style>
  #background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    filter: blur(6.25rem);
  }

  #hero {
    display: flex;
    align-items: start;
    flex-direction: column;
    justify-content: center;
  }

  h1 {
    font-size: 1.375rem;
    margin-top: 0.25em;
  }

  #links {
    display: flex;
    gap: 1rem;
  }

  #links a {
    display: flex;
    align-items: center;
    padding: 0.625rem 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  #links a:hover {
    color: var(--color-accent);
  }

  #links a svg {
    height: 1em;
    margin-left: 0.5rem;
  }

  #links a.button {
    color: white;
    background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
    box-shadow:
      inset 0 0 0 0.0625rem rgba(255, 255, 255, 0.12),
      inset 0 -0.125rem 0 rgba(0, 0, 0, 0.24);
    border-radius: 0.625rem;
  }

  #links a.button:hover {
    color: rgb(230, 230, 230);
    box-shadow: none;
  }

  pre {
    font-weight: normal;
    background: linear-gradient(14deg, #d83333 0%, #f041ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  code {
    display: inline-block;
    background:
      linear-gradient(66.77deg, #f3cddd 0%, #f5cee7 100%) padding-box,
      linear-gradient(155deg, #d83333 0%, #f041ff 18%, #f5cee7 45%) border-box;
    border-radius: 0.5rem;
    border: 0.0625rem solid transparent;
    padding: 0.375rem 0.5rem;
  }

  @media screen and (max-width: 48rem) {
    #hero {
      display: block;
    }

    #links {
      flex-wrap: wrap;
    }

    #links a.button {
      padding: 0.875rem 1.125rem;
    }

    h1 {
      line-height: 1.5;
    }
  }
</style>
