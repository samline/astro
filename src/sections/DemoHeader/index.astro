---
import { getRelativeLocaleUrl } from 'astro:i18n'
import Box from '@/components/Box/index.astro'
import Link from '@/components/Link/index.astro'
import { currentDestination } from '@/components/Link/current'
import ThemeSwitch from '@/components/Theme/Switch.astro'
import LanguagePicker from '@/components/LanguagePicker/index.astro'
import astroLogo from '@/assets/astro.svg'
import { getDictionary, resolveLocale } from '@/i18n'
import Navigation from './Navigation.astro'
import { routePath, resolveRoutePaths, type PageRoute } from '@/i18n/routes'
import { routeNames } from '@/config/routes'

interface Props {
  pageRoute?: PageRoute
}
const { pageRoute } = Astro.props

const locale = resolveLocale(Astro.currentLocale)
const { navigation, welcome } = getDictionary(locale)
const homePath = routePath({ routeName: routeNames.home }, locale)
const links = [
  { routeName: routeNames.home, label: navigation.home },
  { routeName: routeNames.demo, label: navigation.demo }
].flatMap((item) => {
  const path = resolveRoutePaths({ routeName: item.routeName })[locale]
  if (path === undefined) return []
  const href = getRelativeLocaleUrl(locale, path)
  return [
    {
      ...item,
      path,
      href,
      current:
        currentDestination(new URL(href, Astro.url), Astro.url) === 'page'
    }
  ]
})
const path = links.find((item) => item.current)?.path ?? homePath
---

<header class='border-b border-black/10 dark:border-white/15' data-demo-header>
  <Box class='flex flex-wrap items-center justify-between gap-x-8 gap-y-4 py-5'>
    <Link
      href={getRelativeLocaleUrl(locale, homePath)}
      localize={false}
      class='shrink-0'
    >
      <img
        src={astroLogo.src}
        width='96'
        height='40'
        alt={welcome.logoAlt}
        class='dark:brightness-0 dark:invert'
      />
    </Link>
    <div class='flex flex-wrap items-center gap-x-8 gap-y-4'>
      <Navigation {links} />
      <div class='flex flex-wrap items-center gap-5 text-sm [&_a]:underline [&_a]:underline-offset-4 [&_a[aria-current=page]]:font-semibold [&_nav_ul]:flex [&_nav_ul]:flex-wrap [&_nav_ul]:gap-3'>
        <LanguagePicker {...(pageRoute ?? { path })} />
        <ThemeSwitch />
      </div>
    </div>
  </Box>
</header>
