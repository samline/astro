---
import { getRelativeLocaleUrl } from 'astro:i18n'
import Box from '@/components/Box/index.astro'
import Link from '@/components/Link/index.astro'
import ThemeSwitch from '@/components/Theme/Switch.astro'
import LanguagePicker from '@/components/LanguagePicker/index.astro'
import astroLogo from '@/assets/astro.svg'
import { getDictionary, resolveLocale } from '@/i18n'
import Navigation from './Navigation.astro'

const locale = resolveLocale(Astro.currentLocale)
const { navigation, welcome } = getDictionary(locale)
const normalizePath = (value: string) => value.replace(/\/+$/, '') || '/'
const currentPath = normalizePath(Astro.url.pathname)
const links = [
  { path: '/', label: navigation.home },
  { path: '/demo', label: navigation.demo }
].map((item) => {
  const href = getRelativeLocaleUrl(locale, item.path)
  return {
    ...item,
    href,
    current: normalizePath(new URL(href, Astro.url).pathname) === currentPath
  }
})
const path = links.find((item) => item.current)?.path ?? '/'
---

<header class='border-b border-black/10 dark:border-white/15' data-demo-header>
  <Box class='flex flex-wrap items-center justify-between gap-x-8 gap-y-4 py-5'>
    <Link href={links[0].href} localize={false} class='shrink-0'>
      <img
        src={astroLogo.src}
        width='96'
        height='40'
        alt={welcome.logoAlt}
        class='dark:brightness-0 dark:invert'
      />
    </Link>
    <div class='flex flex-wrap items-center gap-x-8 gap-y-4'>
      <Navigation {links} />
      <div class='flex flex-wrap items-center gap-5 text-sm [&_a]:underline [&_a]:underline-offset-4 [&_a[aria-current=page]]:font-semibold [&_nav_ul]:flex [&_nav_ul]:flex-wrap [&_nav_ul]:gap-3'>
        <LanguagePicker path={path} />
        <ThemeSwitch />
      </div>
    </div>
  </Box>
</header>
