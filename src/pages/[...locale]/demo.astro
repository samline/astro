---
import type { GetStaticPaths } from 'astro'
import Main from '@/layouts/Main.astro'
import DemoHeader from '@/sections/DemoHeader/index.astro'
import DemoFooter from '@/sections/DemoFooter/index.astro'
import DemoPage from '@/sections/DemoPage/index.astro'
import { getDictionary } from '@/i18n'
import { defaultLocale, locales } from '@/i18n/config'

export const getStaticPaths = (() =>
  locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale }
  }))) satisfies GetStaticPaths
const { demo } = getDictionary(Astro.currentLocale).welcome
---

<Main path='/demo' title={demo.title} description={demo.description}>
  <DemoHeader slot='header' />
  <DemoPage />
  <DemoFooter slot='footer' />
</Main>
