{
  "name": "astro-kit",
  "type": "module",
  "version": "7.11.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.23.4",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "preinstall": "node scripts/check-package-manager.mjs",
    "dev": "bun --bun ./node_modules/astro/bin/astro.mjs dev --background",
    "build": "bun --bun ./node_modules/astro/bin/astro.mjs build",
    "preview": "bun --bun ./node_modules/astro/bin/astro.mjs preview",
    "astro": "bun --bun ./node_modules/astro/bin/astro.mjs",
    "check": "bun --bun ./node_modules/astro/bin/astro.mjs check",
    "check:i18n": "bun scripts/check-i18n.mjs",
    "format": "bun --bun ./node_modules/prettier/bin/prettier.cjs . --write",
    "format:check": "bun --bun ./node_modules/prettier/bin/prettier.cjs . --check",
    "verify": "bun run format:check && bun run check:i18n && bun run check && bun run test && bun run build",
    "test": "bun run kit:prepare && bun test tests",
    "kit:prepare": "bun scripts/prepare-package.mjs",
    "kit:pack": "bun run kit:prepare && pnpm --dir packages/cli pack --pack-destination ../../artifacts",
    "kit:version": "bun scripts/release-version.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "11.0.16",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
