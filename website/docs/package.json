{
  "name": "@package-site/docs",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bun --bun ./node_modules/astro/bin/astro.mjs dev",
    "build": "bun --bun ./node_modules/astro/bin/astro.mjs build && bun --bun ./node_modules/pagefind/lib/runner/bin.cjs --site dist",
    "preview": "bun --bun ./node_modules/astro/bin/astro.mjs preview",
    "check": "bun --bun ./node_modules/astro/bin/astro.mjs check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/sitemap": "^3.7.4",
    "@samline/drawer": "5.0.2",
    "@tailwindcss/vite": "4.3.0",
    "astro": "^7.4.2",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "pagefind": "^1.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "6.0.3"
  }
}
