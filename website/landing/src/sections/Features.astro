---
import CardGrid from '../../../shared/components/CardGrid.astro'
import { getI18n } from '../i18n/utils'
import Section from '../../../shared/components/Section.astro'
import Box from '../../../shared/components/Box.astro'
import SectionHeading from '../components/SectionHeading.astro'
import RichText from '../components/RichText.astro'
import FeatureCard from '../components/FeatureCard.astro'
const i18n = getI18n(Astro)
const t = i18n.sections.features
const headingId = `section-heading-${crypto.randomUUID()}`
---

<Section
  aria-labelledby={headingId}
  spacing="none"
  id="features"
  class:list={['content-section features-section']}
>
  <Box>
    <SectionHeading
      headingId={headingId}
      context="features"
      eyebrow={t.eyebrow}
      class:list={['mb-12 flex flex-col items-start gap-3']}
    >
      {t.title}
      <br />
      <span class:list={['serif italic']}>{t.titleAccent}</span>
    </SectionHeading>

    <CardGrid columns={3} class:list={['feature-grid']}>
      <FeatureCard title={t.items.dependencies.title} number="01">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="7" height="7" rx="1.5" />
            <path d="m5 6 1.5 1.5L9 5" />
            <rect x="14" y="3" width="7" height="7" rx="1.5" />
            <rect x="3" y="14" width="7" height="7" rx="1.5" />
            <rect x="14" y="14" width="7" height="7" rx="1.5" />
          </svg>
        </Fragment>
        <RichText parts={t.items.dependencies.description} />
      </FeatureCard>
      <FeatureCard title={t.items.accessibility.title} number="02">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <path d="M3 9h18M10 9v12" />
          </svg>
        </Fragment>
        <RichText parts={t.items.accessibility.description} />
      </FeatureCard>
      <FeatureCard title={t.items.lifecycle.title} number="03">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 3H4a1 1 0 0 0-1 1v5h4a2 2 0 1 1 0 4H3v7a1 1 0 0 0 1 1h7v-4a2 2 0 1 1 4 0v4h5a1 1 0 0 0 1-1v-5M15 3h6v6M14 10l7-7" />
          </svg>
        </Fragment>
        <RichText parts={t.items.lifecycle.description} />
      </FeatureCard>
      <FeatureCard title={t.items.entrypoints.title} number="04">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 5h11M8 3v2M5 5c0 5 3 8 7 10M12 5c-1 6-4 9-9 11M14 21l4-11 4 11M15.5 17h5" />
          </svg>
        </Fragment>
        <RichText parts={t.items.entrypoints.description} />
      </FeatureCard>
      <FeatureCard title={t.items.frameworks.title} number="05">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <path d="m6 9 3 3-3 3M12 15h5" />
          </svg>
        </Fragment>
        <RichText parts={t.items.frameworks.description} />
      </FeatureCard>
      <FeatureCard title={t.items.markup.title} number="06">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 6h6v6H3zM15 12h6v6h-6zM9 9h4a5 5 0 0 1 5 5M15 6l-3 3 3 3" />
          </svg>
        </Fragment>
        <RichText parts={t.items.markup.description} />
      </FeatureCard>
    </CardGrid>
  </Box>
</Section>

<style>
  .feature-grid {
    gap: 0.75rem;
  }
  @media (width < 48rem) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (width < 30rem) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
