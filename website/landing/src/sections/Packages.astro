---
import Section from '../../../shared/components/Section.astro'
import Box from '../../../shared/components/Box.astro'
import '@samline/ticker/style.css'
import Button from '../../../shared/components/Button.astro'
import Surface from '../../../shared/components/Surface.astro'
import SectionHeading from '../components/SectionHeading.astro'
import { getI18n } from '../i18n/utils'
const t = getI18n(Astro).packages
const illustrations = import.meta.glob<string>('./Packages/art/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true
})
---

<Section
  id="packages"
  aria-labelledby="packages-heading"
  spacing="none"
  class:list={['content-section']}
>
  <Box>
    <SectionHeading headingId="packages-heading" eyebrow={t.eyebrow}>
      {t.title + ' '}
      <span class:list={['serif']}>{t.accent}</span>
      <Fragment slot="description">{t.description}</Fragment>
    </SectionHeading>
    <package-catalog class:list={['catalog']}>
      <div class:list={['catalog-controls']} data-controls inert>
        <Button
          variant="secondary"
          class="step-control"
          data-previous
          aria-label={t.previous}
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m14 6-6 6 6 6" />
          </svg>
        </Button>
        <Button
          variant="secondary"
          class="step-control"
          data-playback
          data-play={t.play}
          data-pause={t.pause}
          aria-label={t.pause}
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path data-playback-icon d="M9 5v14M15 5v14" />
          </svg>
        </Button>
        <Button
          variant="secondary"
          class="step-control"
          data-next
          aria-label={t.next}
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m10 6 6 6-6 6" />
          </svg>
        </Button>
      </div>
      <div class:list={['catalog-viewport']}>
        <ul class:list={['grid']} data-packages>
          {t.items.map((item) => (
            <li>
              <Surface as="article" interactive class:list={['card']}>
                <div class:list={['art']} aria-hidden="true">
                  <Fragment
                    set:html={illustrations[`./Packages/art/${item.id}.svg`]}
                  />
                </div>
                <p class:list={['meta']}>{item.category}</p>
                <h3 class:list={['name']}>
                  <a href={item.href}>{item.name}</a>
                </h3>
                <p class:list={['summary']}>{item.description}</p>
                <ul
                  class:list={['highlights']}
                  aria-label={`${item.name}: ${t.highlights}`}
                >
                  {item.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
                <div class:list={['footer']}>
                  <code class:list={['npm']}>{item.npm}</code>
                  <p class:list={['links']}>
                    <a href={item.docs} aria-label={`${item.name}: ${t.docs}`}>
                      {t.docs}
                    </a>
                  </p>
                </div>
              </Surface>
            </li>
          ))}
        </ul>
      </div>
    </package-catalog>
  </Box>
</Section>

<script>
  import { ticker } from '@samline/ticker'
  import { mountElements } from '../../../shared/lib/mount-elements'

  mountElements('package-catalog', (root) => {
    const source = root.querySelector<HTMLElement>('[data-packages]')!
    const controls = root.querySelector<HTMLElement>('[data-controls]')!
    const playback = root.querySelector<HTMLButtonElement>('[data-playback]')!
    const playbackIcon = playback.querySelector<SVGPathElement>(
      '[data-playback-icon]'
    )!
    const controller = ticker(source, {
      speed: 28,
      direction: 'left',
      pauseOnHover: true,
      pauseOnFocus: true,
      navigation: true,
      interactiveClones: true,
      class: 'packages-viewport'
    })
    if (!controller) return
    const disconnect = controller.connectControls({
      previous: root.querySelector<HTMLButtonElement>('[data-previous]')!,
      next: root.querySelector<HTMLButtonElement>('[data-next]')!
    })
    const render = () => {
      playback.setAttribute(
        'aria-label',
        controller.state.requested
          ? playback.dataset.pause!
          : playback.dataset.play!
      )
      playbackIcon.setAttribute(
        'd',
        controller.state.requested ? 'M9 5v14M15 5v14' : 'm8 5 11 7-11 7Z'
      )
    }
    const unsubscribe = controller.on('playback', render)
    const events = new AbortController()
    playback.addEventListener(
      'click',
      () => {
        if (controller.state.requested) controller.pause()
        else controller.play()
      },
      { signal: events.signal }
    )
    render()
    controls.inert = false
    return () => {
      events.abort()
      unsubscribe()
      disconnect()
      controller.destroy()
      controls.inert = true
    }
  })
</script>

<style>
  .catalog {
    display: block;
    margin-top: 2.5rem;
  }
  .catalog-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .catalog-controls :global(.step-control) {
    padding-inline: 0.75rem;
  }
  .step-control svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .catalog-controls[inert] {
    visibility: hidden;
  }
  .catalog-viewport {
    overflow-x: auto;
    padding: 0.375rem;
  }
  .catalog-viewport :global(.packages-viewport) {
    padding-block: 0.375rem;
  }
  .catalog-viewport :global(.ticker-track),
  .catalog-viewport :global(.ticker-content) {
    gap: var(--space-md);
  }
  .grid {
    display: flex;
    gap: var(--space-md);
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grid > li {
    display: flex;
    flex: 0 0 auto;
    width: min(20rem, calc(100vw - 4rem));
    min-width: 0;
  }
  .card {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.75rem 0.75rem var(--space-lg);
    transition: border-color var(--duration-ui) var(--ease-ui);
  }
  .card > :not(.art) {
    margin-inline: 0.75rem;
  }
  .art {
    display: grid;
    place-items: center;
    aspect-ratio: 240 / 132;
    margin: 0 0 0.25rem;
    border-radius: calc(var(--radius-panel) - 0.375rem);
    background:
      radial-gradient(
        circle at 50% 120%,
        color-mix(in oklab, var(--color-accent) 16%, transparent),
        transparent 70%
      ),
      color-mix(in oklab, var(--color-text) 4%, transparent);
    color: var(--color-text);
    overflow: hidden;
  }
  .art :global(svg) {
    width: 100%;
    height: 100%;
    transition: transform var(--duration-ui) var(--ease-ui);
  }
  /* Art classes for site/card.svg: neutral fills and lines, accent marks and text. */
  .art :global(.f) {
    fill: color-mix(in oklab, currentColor 9%, transparent);
  }
  .art :global(.f2) {
    fill: color-mix(in oklab, currentColor 20%, transparent);
  }
  .art :global(.s) {
    fill: none;
    stroke: color-mix(in oklab, currentColor 30%, transparent);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .art :global(.a) {
    fill: var(--color-accent);
  }
  .art :global(.al) {
    fill: color-mix(in oklab, var(--color-accent) 16%, transparent);
  }
  .art :global(.as) {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .art :global(.al.as) {
    fill: color-mix(in oklab, var(--color-accent) 16%, transparent);
    stroke-width: 1.5;
  }
  .art :global(.dash) {
    stroke-dasharray: 4 5;
  }
  .art :global(text) {
    fill: var(--color-text-muted);
    font: 500 11px var(--font-mono);
  }
  .art :global(.strong) {
    fill: var(--color-text);
    font-size: 13px;
  }
  .art :global(.accent) {
    fill: var(--color-accent);
  }
  .art :global(.num) {
    font: 600 30px var(--font-sans, inherit);
    letter-spacing: -0.03em;
  }
  .art :global(.ghost) {
    fill: currentColor;
    opacity: 0.18;
    font-size: 22px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-block: 0;
    color: var(--color-text-subtle);
    font: 0.65rem/1.6 var(--font-mono);
  }
  .name {
    margin-block: 0;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .name a {
    color: var(--color-text);
    text-decoration: none;
    outline: none;
  }
  /* The title link covers the whole card; the footer links sit above it. */
  .name a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
  }
  .card:has(.name a:focus-visible) {
    outline: var(--focus-width) solid var(--color-accent);
    outline-offset: var(--focus-offset);
  }
  .summary {
    flex: 1;
    margin-block: 0;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .highlights {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 0.375rem;
    margin-block: 0;
    padding: 0;
    list-style: none;
  }
  .highlights li {
    padding: 0.125rem 0.5rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: 999rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .footer {
    display: grid;
    align-content: end;
    gap: 0.625rem;
    padding-top: 0.875rem;
    border-top: 0.0625rem solid var(--color-border-soft);
  }
  .npm {
    font-size: var(--text-small);
    color: var(--color-text-subtle);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin: 0;
  }
  .links a {
    position: relative;
    z-index: 1;
    color: var(--color-text);
    font-size: var(--text-small);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: color-mix(
      in oklab,
      var(--color-accent) 60%,
      transparent
    );
    text-underline-offset: 0.2em;
  }
  .links a:focus-visible {
    outline: var(--focus-width) solid var(--color-accent);
    outline-offset: var(--focus-offset);
    border-radius: 0.125rem;
  }
  @media (hover: hover) {
    .card:hover {
      border-color: color-mix(
        in oklab,
        var(--color-accent) 55%,
        var(--palette-feature-border)
      );
    }
    .card:hover .name a {
      color: var(--color-accent);
    }
    .card:hover .art :global(svg) {
      transform: scale(1.04);
    }
    .links a:hover {
      color: var(--color-accent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .art :global(svg) {
      transition: none;
    }
    .card:hover,
    .card:hover .art :global(svg) {
      transform: none;
    }
  }
</style>
