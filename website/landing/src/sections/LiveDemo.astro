---
import Playground from '../../../shared/components/Playground.astro'
const { id = 'demo' } = Astro.props
---

<div id={id} class:list={['live-demo']}>
  <Playground />
</div>

<style>
  .live-demo {
    margin-top: 2.625rem;
    scroll-margin-top: 1.5rem;
  }
  @media (width<48rem) {
    .live-demo {
      margin-top: 2.5rem;
    }
  }
</style>
