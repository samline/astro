---
import DemoPanel from './DemoPanel.astro'
import ToolCommands from './ToolCommands.astro'
import TextLink from './TextLink.astro'
import { recipes } from '../i18n/translations/en/recipes'
import { project } from '../lib/project.mjs'
import t from '../i18n/translations/en/demo'
interface Props {
  recipe: (typeof recipes)[number]
}
const { recipe } = Astro.props
---

<DemoPanel label={recipe.label} tagline={t.previewTagline}>
  <div class:list={['recipe-content']}>
    <p>{recipe.description}</p>
    <dl>
      <div>
        <dt>{t.runFrom}</dt>
        <dd>{recipe.runFrom}</dd>
      </div>
      <div>
        <dt>{t.requires}</dt>
        <dd>{recipe.requires}</dd>
      </div>
    </dl>
    <ToolCommands
      args={[recipe.command.replace(/^npx @samline\/astro\s+/, '')]}
    />
    <div>
      <p class:list={['step-title']}>{t.result}</p>
      <p>{recipe.result}</p>
    </div>
    <details>
      <summary>{t.generated}</summary>
      <pre
        tabindex="0"
        role="group"
        aria-label={t.filesLabel}
      ><code>{recipe.files}</code></pre>
    </details>
    <p>{recipe.note}</p>
    <div>
      <p class:list={['step-title']}>{t.next}</p>
      <p>{recipe.nextStep}</p>
    </div>
    <TextLink href={project.docsBase + recipe.guide}>{t.guide}</TextLink>
  </div>
</DemoPanel>
<style>
  .recipe-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md);
    padding-block: 0.25rem 0.75rem;
  }
  p,
  dd {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: 1.75;
    margin: 0;
  }
  dl {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-sm);
  }
  dt,
  .step-title,
  summary {
    color: var(--color-text);
    font-size: var(--text-small);
    font-weight: 500;
    line-height: 1.5;
  }
  dt,
  .step-title {
    margin-bottom: 0.375rem;
  }
  details {
    border-block: 0.0625rem solid var(--color-border-soft);
    padding-block: var(--space-sm);
  }
  summary {
    cursor: pointer;
    padding-block: 0.5rem;
  }
  pre {
    overflow-x: auto;
    padding-block: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.75;
  }
  :focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.25rem;
  }
</style>
