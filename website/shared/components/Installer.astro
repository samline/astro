---
import Tabs from './Tabs.astro'
import TabPanel from './TabPanel.astro'
import CodeFrame from './CodeFrame.astro'
import { project } from '../lib/project.mjs'
import controls from '../i18n/translations/en/controls'
import { format } from '../i18n/format'
const { class: className, id = `install-${crypto.randomUUID()}` } = Astro.props
const panels = [
  {
    id: 'npm',
    label: 'npm',
    language: 'bash' as const,
    code: `npx ${project.npmName} my-site --package-manager npm --runtime node`
  },
  {
    id: 'pnpm',
    label: 'pnpm',
    language: 'bash' as const,
    code: `pnpm dlx ${project.npmName} my-site --package-manager pnpm --runtime node`
  },
  {
    id: 'bun',
    label: 'Bun',
    language: 'bash' as const,
    code: `bunx ${project.npmName} my-site --package-manager bun --runtime bun`
  }
]
---

<Tabs
  class:list={[className]}
  id={id}
  label={controls.install.label}
  items={panels}
>
  {panels.map((item) => (
    <TabPanel id={item.id} label={item.label}>
      <CodeFrame
        label={controls.install.filename}
        text={item.code}
        language={item.language}
        copyLabel={format(controls.code.copyLabel, { filename: item.label })}
      />
    </TabPanel>
  ))}
</Tabs>
