# Local development. In Vercel, set SITE_URL to the final production origin.
SITE_URL=http://localhost:4321

# Optional override for robots, sitemap and meta robots.
# Default: production build with non-local origin, excluding detected previews.
# Set false in staging (also Cloudflare previews and custom hosting).
# SITE_INDEXABLE=false

# Optional Google Tag Manager container. Unset means no GTM or consent UI.
# Enabled by default only in production on a non-local origin, excluding previews.
# GTM_ID=GTM-XXXXXXX
# GTM_ENABLED=false

# Optional: generate with `bun run astro create-key` when a persistent
# Server Islands encryption key is needed across deployments.
# Store the generated value in Vercel, never in version control.
# ASTRO_KEY=

# Optional SMTP mail. Disabled until explicitly enabled; requires server runtime.
# See src/server/mail/README.md. Set secrets in your hosting environment.
# MAIL_ENABLED=false
# MAIL_FROM=website@example.com
# MAIL_TO=team@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Optional content API examples. No remote request runs by default.
# Base URL includes the API path, for example https://cms.example.com/api/.
# Configure separately at build time (loaders) and runtime (Actions/live).
# CONTENT_API_URL=https://cms.example.com/api/
# CONTENT_API_TOKEN=

# Optional CAPTCHA. none (default), turnstile (Cloudflare) or recaptcha (Google v2 checkbox).
# Provider/site key/hostnames are build settings; the secret is runtime-only.
# See src/components/Captcha/README.md. CAPTCHA still requires a backend on static hosting.
# CAPTCHA_PROVIDER=none
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=
# Comma-separated exact hosts. Default: SITE_URL hostname. Include localhost only for local testing.
# CAPTCHA_HOSTNAMES=example.com,www.example.com

# Optional authentication. Disabled by default; activate the example auth route too.
# See src/server/auth/README.md. Only private routes/islands need server rendering.
# AUTH_MODE=disabled
# AUTH_URL=https://example.com
# Generate a random secret, for example: openssl rand -base64 48
# AUTH_SECRET=
# Session lifetime in seconds: 60..86400. Defaults: external/oauth 900, database 3600.
# AUTH_SESSION_SECONDS=900
# Database mode owns users (PostgreSQL). Run auth:migrate explicitly after configuring.
# AUTH_DATABASE_URL=postgresql://user:password@localhost:5432/project
# External REST mode: HTTPS base including the API path; HTTP is allowed on loopback.
# AUTH_API_URL=https://api.example.com/api/
# AUTH_API_KEY=
# AUTH_API_LOGIN_PATH=auth/login
# AUTH_API_PROFILE_PATH=auth/profile
# Optional refresh before expiration. Must return the same login envelope.
# AUTH_API_REFRESH_PATH=auth/refresh
# Optional: enable only if this endpoint revokes the user's token.
# AUTH_API_LOGOUT_PATH=auth/logout
# Optional OIDC discovery mode (provider ID: identity). Plain OAuth2 uses config.ts.
# AUTH_OAUTH_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
# AUTH_OAUTH_CLIENT_ID=
# AUTH_OAUTH_CLIENT_SECRET=
