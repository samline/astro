# Local development. In Vercel, set SITE_URL to the final production origin.
SITE_URL=http://localhost:4321

# Optional override for robots, sitemap and meta robots.
# Default: production build with non-local origin, excluding detected previews.
# Set false in staging (also Cloudflare previews and custom hosting).
# SITE_INDEXABLE=false

# Optional Google Tag Manager container. Unset means no GTM or consent UI.
# Enabled by default only in production on a non-local origin, excluding previews.
# GTM_ID=GTM-XXXXXXX
# GTM_ENABLED=false

# Optional: generate with `bun run astro create-key` when a persistent
# Server Islands encryption key is needed across deployments.
# Store the generated value in Vercel, never in version control.
# ASTRO_KEY=
